# Scop: Constructia modelelor OLS + diagnostic + Train/Test (out-of-sample)
#       + Region dummy (Req 4a) + What-if East (Req 4b) + RMSE/MAE (Req 3c)
# ==============================================================================
source("scripts/common.R")
library(tidyverse)
library(lmtest)
library(sandwich)
library(car)
library(stargazer)
# 1. Incarcare date
processed_path <- "data/processed/"
df <- readRDS(file.path(processed_path, "analysis_data_enriched.rds"))
output_tabs <- "output/tables/"
if (!dir.exists(output_tabs)) dir.create(output_tabs, recursive = TRUE)
message("--- Start Modelare Econometrica (Train/Test) ---")
# ==============================================================================
# 1b. Fallback: daca Region nu exista in RDS, o construim aici (din geo)
# (Ca sa nu depinzi de data_cleaning pentru rulare)
# ==============================================================================
if (!("Region" %in% names(df))) {
message("WARNING: Region nu exista in dataset. O construim automat din geo (fallback).")
east_countries <- c("BG", "CZ", "EE", "HR", "HU", "LT", "LV", "PL", "RO", "SI", "SK")
df$Region <- ifelse(df$geo %in% east_countries, "East", "West")
df$Region <- factor(df$Region, levels = c("West", "East"))
}
# ==============================================================================
# 2. Helpers metrics (Req 3c)
# ==============================================================================
rmse <- function(actual, pred) sqrt(mean((actual - pred)^2, na.rm = TRUE))
mae  <- function(actual, pred) mean(abs(actual - pred), na.rm = TRUE)
# ==============================================================================
# 3. Train/Test split 80/20 (Req 3c)
# ==============================================================================
set.seed(123)
n <- nrow(df)
idx_train <- sample(seq_len(n), size = floor(0.8 * n), replace = FALSE)
train <- df[idx_train, ]
test  <- df[-idx_train, ]
# ==============================================================================
# 4. Definirea modelelor OLS (antrenare pe TRAIN) + Region (Req 4a)
# ==============================================================================
m1 <- lm(EMP_TECH ~ DESI_AI + Region, data = train)
m2 <- lm(EMP_TECH ~ DESI_AI + STEM_GRAD + ln_GDP_CAP + GOV_RD + Region, data = train)
m3 <- lm(EMP_TECH ~ PC1_Digital + ln_GDP_CAP + Region, data = train)
m4 <- lm(EMP_TECH ~ DESI_AI * STEM_GRAD + ln_GDP_CAP + Region, data = train)
# ==============================================================================
# 5. Raportare coeficienti (TRAIN) - Stargazer
# ==============================================================================
stargazer(m1, m2, m3, m4, type = "text",
title = "Rezultatele Regresiei OLS (TRAIN) (Variabila Dep: Ocupare Tech)",
out = file.path(output_tabs, "regression_results_train.txt"))
# ==============================================================================
# 6. Evaluare out-of-sample pe TEST (Req 3c): RMSE + MAE
# ==============================================================================
pred_m1 <- predict(m1, newdata = test)
pred_m2 <- predict(m2, newdata = test)
pred_m3 <- predict(m3, newdata = test)
pred_m4 <- predict(m4, newdata = test)
perf <- data.frame(
Model = c("m1", "m2", "m3", "m4"),
RMSE_Test = c(
rmse(test$EMP_TECH, pred_m1),
rmse(test$EMP_TECH, pred_m2),
rmse(test$EMP_TECH, pred_m3),
rmse(test$EMP_TECH, pred_m4)
),
MAE_Test = c(
mae(test$EMP_TECH, pred_m1),
mae(test$EMP_TECH, pred_m2),
mae(test$EMP_TECH, pred_m3),
mae(test$EMP_TECH, pred_m4)
)
)
print(perf)
write.csv(perf, file.path(output_tabs, "ols_test_metrics.csv"), row.names = FALSE)
# ==============================================================================
# 7. Diagnosticare (pentru Modelul 2) - pe TRAIN
# ==============================================================================
message("Diagnosticare Model Complet (m2) pe TRAIN...")
resid_m2 <- residuals(m2)
# A. Normalitatea Reziduurilor (Shapiro)
st_shapiro <- shapiro.test(resid_m2)
print(st_shapiro)
# B. Homoscedasticitate (Breusch-Pagan)
test_bp <- bptest(m2)
print(test_bp)
# C. Multicoliniaritate (VIF)
vif_res <- vif(m2)
print(vif_res)
# D. Testul RESET (Ramsey) pentru forma functionala
reset_res <- resettest(m2, power = 2:3, type = "regressor")
print(reset_res)
# ==============================================================================
# 8. What-If (Req 4b): DESI_AI +10% DOAR in tarile din EAST (pe TEST)
# ==============================================================================
message("Scenariu What-If: +10% DESI_AI doar in tarile din East (evaluare pe TEST)...")
new_data <- test
new_data$DESI_AI <- ifelse(new_data$Region == "East",
new_data$DESI_AI * 1.10,
new_data$DESI_AI)
pred_baseline <- predict(m2, newdata = test)
pred_scenario <- predict(m2, newdata = new_data)
mean_increase_east <- mean(
(pred_scenario - pred_baseline)[test$Region == "East"],
na.rm = TRUE
)
message(paste("Crestere medie estimata a EMP_TECH in EAST la +10% AI:", round(mean_increase_east, 4)))
message("Modelarea clasica finalizata.")
cat('/f')
cat('\f')
View(install_and_load)
