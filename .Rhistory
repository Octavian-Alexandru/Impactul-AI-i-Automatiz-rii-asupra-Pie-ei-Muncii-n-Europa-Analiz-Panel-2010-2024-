# ==============================================================================
set.seed(123)
cv_lasso <- cv.glmnet(x_train, y_train, alpha = 1)
best_lambda_lasso <- cv_lasso$lambda.min
message(paste("Lambda optim Lasso:", best_lambda_lasso))
model_lasso <- glmnet(x_train, y_train, alpha = 1, lambda = best_lambda_lasso)
message("Coeficientii Lasso (feature selection):")
print(coef(model_lasso))
# ==============================================================================
# 6. Elastic Net (alpha = 0.5) - Req 5a
# ==============================================================================
set.seed(123)
cv_elnet <- cv.glmnet(x_train, y_train, alpha = 0.5)
best_lambda_elnet <- cv_elnet$lambda.min
message(paste("Lambda optim ElasticNet:", best_lambda_elnet))
model_elnet <- glmnet(x_train, y_train, alpha = 0.5, lambda = best_lambda_elnet)
# ==============================================================================
# 7. Comparatie performanta pe TEST: OLS vs Ridge vs Lasso vs ElasticNet
# ==============================================================================
preds_ols <- predict(lm(EMP_TECH ~ ., data = df_train), newdata = df_test)
preds_ridge <- predict(model_ridge, s = best_lambda_ridge, newx = x_test)
preds_lasso <- predict(model_lasso, s = best_lambda_lasso, newx = x_test)
preds_elnet <- predict(model_elnet, s = best_lambda_elnet, newx = x_test)
res_comparatie <- data.frame(
Model = c("OLS Full", "Ridge", "Lasso", "ElasticNet"),
RMSE_Test = c(
rmse(y_test, preds_ols),
rmse(y_test, preds_ridge),
rmse(y_test, preds_lasso),
rmse(y_test, preds_elnet)
)
)
print(res_comparatie)
write.csv(res_comparatie, file.path(output_tabs, "ml_comparison_test.csv"), row.names = FALSE)
message("Analiza ML finalizata.")
